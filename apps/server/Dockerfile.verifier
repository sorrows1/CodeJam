FROM node:22-bookworm-slim
WORKDIR /verifier
RUN npm init -y && npm install --omit=dev --no-fund --no-audit playwright@1.62.1 vite@7.3.6 react@19.2.0 react-dom@19.2.0 vue@3.5.28 @vue/compiler-sfc@3.5.28 @vitejs/plugin-vue@6.0.8 && npx playwright install --with-deps chromium
COPY verifier-harness.mjs /verifier/harness.mjs
COPY verifier-vite.config.mjs /verifier/vite.config.mjs
COPY preview-prepare.mjs /preview/prepare.mjs
COPY preview-vite.config.mjs /preview/vite.config.mjs
ENTRYPOINT ["node", "/verifier/harness.mjs"]
